{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "DummyForTest",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/definitions/Something"
    }
  ],
  "$id": "https://dummy.com",
  "definitions": {
    "Branch": {
      "allOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "properties": {
            "optionalChildren": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node_choice"
              }
            },
            "modelType": {
              "const": "Branch"
            }
          }
        }
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "alpha",
        "beta",
        "gamma"
      ]
    },
    "Leaf": {
      "allOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "properties": {
            "optionalItem": {
              "$ref": "#/definitions/Item"
            },
            "modelType": {
              "const": "Leaf"
            }
          }
        }
      ]
    },
    "ModelType": {
      "type": "string",
      "enum": [
        "Branch",
        "Leaf"
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "modelType": {
          "$ref": "#/definitions/ModelType"
        }
      },
      "required": [
        "modelType"
      ]
    },
    "Node_choice": {
      "oneOf": [
        {
          "$ref": "#/definitions/Branch"
        },
        {
          "$ref": "#/definitions/Leaf"
        }
      ]
    },
    "Something": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/definitions/Item"
        },
        "optionalText": {
          "type": "string"
        },
        "optionalNumber": {
          "type": "integer"
        },
        "optionalItem": {
          "$ref": "#/definitions/Item"
        },
        "optionalTexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalKind": {
          "$ref": "#/definitions/Kind"
        },
        "optionalFlag": {
          "type": "boolean"
        }
      },
      "required": [
        "item"
      ]
    }
  }
}